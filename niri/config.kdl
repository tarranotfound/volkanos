// Volkanos — starter configuration for Niri.
// Review output names, installed commands, and input preferences before use.

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse
}

layout {
    gaps 8
    center-focused-column "never"

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#e0283b"
        inactive-color "#7c8a93"
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/screenshot-%Y-%m-%d_%H-%M-%S.png"

// Start optional Volkanos components when the session begins.
spawn-at-startup "bash" "-c" "bash ~/.config/niri/startup.sh"

binds {
    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+L { spawn "hyprlock"; }
    Mod+F { maximize-column; }
    Mod+Shift+E { quit; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }
    Mod+Shift+WheelScrollDown { move-column-right; }
    Mod+Shift+WheelScrollUp { move-column-left; }
}
