#!/usr/bin/env bash
set -Eeuo pipefail

readonly VOLKANOS_RED='\033[31m'
readonly RESET='\033[0m'
readonly BACKUP_ROOT="$HOME/.local/share/volkanos/backups"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

if [[ ${EUID} -eq 0 ]]; then
  printf '%bDo not run Volkanos Setup as root.%b\n' "$VOLKANOS_RED" "$RESET" >&2
  exit 1
fi

check_environment() {
  local missing=0

  for command_name in bash sudo pacman; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
      printf 'Missing required command: %s\n' "$command_name" >&2
      missing=1
    fi
  done

  if [[ ! -d "$REPO_ROOT" ]]; then
    printf 'Repository root not found: %s\n' "$REPO_ROOT" >&2
    missing=1
  fi

  (( missing == 0 )) || exit 1
}

if ! command -v gum >/dev/null 2>&1; then
  printf 'Volkanos Setup needs gum for its terminal menu.\n'
  read -r -p 'Install gum with pacman? [y/N] ' answer
  if [[ $answer =~ ^[Yy]$ ]]; then
    sudo pacman -S --needed gum
  else
    printf 'gum is required. Exiting.\n' >&2
    exit 1
  fi
fi

check_environment

components=(
  'Hyprland|hyprland|hypr'
  'Niri|niri|niri'
  'Kitty|kitty|kitty'
  'Waybar|waybar|waybar'
  'Quickshell|quickshell|quickshell'
  'Fuzzel|fuzzel|fuzzel'
  'btop|btop|btop'
  'Cava|cava|cava'
  'Neovim|neovim|nvim'
  'Fastfetch|fastfetch|fastfetch'
  'Vibe|vibe|vibe'
  'Wallpapers tools|swww|swww'
)

labels=()
declare -A packages
for item in "${components[@]}"; do
  label=${item%%|*}
  remainder=${item#*|}
  package=${remainder%%|*}
  config_name=${remainder##*|}
  labels+=("$label")
  packages["$label"]="$package|$config_name"
done

validate_selection() {
  local label package unavailable=0
  local -a missing_packages=()

  while IFS= read -r label; do
    [[ -z $label ]] && continue
    package=${packages[$label]%%|*}

    if pacman -Si "$package" >/dev/null 2>&1 || pacman -Qi "$package" >/dev/null 2>&1; then
      printf '  [ok] %s\n' "$package"
    else
      printf '  [missing] %s\n' "$package"
      missing_packages+=("$package")
      unavailable=1
    fi
  done <<< "$selected"

  if (( unavailable )); then
    printf '\nUnavailable packages were selected:\n'
    printf '  - %s\n' "${missing_packages[@]}"
    printf '\nRefresh your package databases or install these packages manually.\n'
    printf 'Installation has been cancelled for safety.\n' >&2
    return 1
  fi
}

backup_configs() {
  local timestamp backup_dir label config_name config_dir
  timestamp=$(date +%Y%m%d-%H%M%S)
  backup_dir="$BACKUP_ROOT/$timestamp"
  mkdir -p "$backup_dir"

  while IFS= read -r label; do
    [[ -z $label ]] && continue
    config_name=${packages[$label]##*|}
    config_dir="$HOME/.config/$config_name"
    if [[ -e $config_dir ]]; then
      cp -a "$config_dir" "$backup_dir/"
      printf '  Backed up: %s\n' "$config_dir"
    else
      printf '  Skipped: %s (not found)\n' "$config_dir"
    fi
  done <<< "$selected"

  printf '\nBackup saved to: %s\n' "$backup_dir"
}

deploy_directory() {
  local label source target
  label=$1
  source=$2
  target=$3

  if [[ ! -d "$source" ]]; then
    printf '  No config found for %s; skipped.\n' "$label"
    return 0
  fi

  mkdir -p "$target"
  cp -a "$source/." "$target/"
  printf '  Deployed: %s -> %s\n' "$label" "$target"
}

deploy_hyprland() {
  local target file deployed=0
  target="$HOME/.config/hypr"
  mkdir -p "$target"

  for file in hyprland.lua hyprland.conf monitors.conf workspaces.conf hyprlock.conf; do
    if [[ -f "$REPO_ROOT/$file" ]]; then
      cp -a "$REPO_ROOT/$file" "$target/"
      printf '  Deployed: %s -> %s/%s\n' "$file" "$target" "$file"
      deployed=1
    fi
  done

  if (( deployed == 0 )); then
    printf '  No Hyprland config files found; skipped.\n'
  fi
}

deploy_configs() {
  local label config_name source target
  while IFS= read -r label; do
    [[ -z $label ]] && continue
    config_name=${packages[$label]##*|}

    case "$config_name" in
      hypr)
        deploy_hyprland
        ;;
      kitty|waybar|fuzzel|btop|cava|nvim|quickshell|niri|fastfetch|vibe)
        source="$REPO_ROOT/$config_name"
        target="$HOME/.config/$config_name"
        deploy_directory "$label" "$source" "$target"
        ;;
    esac
  done <<< "$selected"
}

printf '%bVOLKANOS SETUP%b\n\n' "$VOLKANOS_RED" "$RESET"
selected=$(printf '%s\n' "${labels[@]}" | gum choose --no-limit --header='Select components to install:') || exit 0

if [[ -z ${selected//[[:space:]]/} ]]; then
  printf 'No components selected. Exiting.\n'
  exit 0
fi

install_packages=()
while IFS= read -r label; do
  [[ -z $label ]] && continue
  install_packages+=("${packages[$label]%%|*}")
done <<< "$selected"

printf '\nSelected packages:\n'
printf '  - %s\n' "${install_packages[@]}"
printf '\nChecking package availability:\n'
validate_selection || exit 1

gum confirm 'Create a backup of existing configs before installation?' && backup_configs
gum confirm 'Continue with installation?' || exit 0

sudo pacman -S --needed "${install_packages[@]}"

gum confirm 'Deploy selected Volkanos configs now?' && deploy_configs

printf '\nVolkanos Setup finished.\n'
