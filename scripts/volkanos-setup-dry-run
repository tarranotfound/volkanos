#!/usr/bin/env bash
set -Eeuo pipefail

readonly RED='\033[31m'
readonly RESET='\033[0m'

printf '%bVOLKANOS SETUP — DRY RUN%b\n\n' "$RED" "$RESET"

if [[ ${EUID} -eq 0 ]]; then
  printf '%bDo not run this helper as root.%b\n' "$RED" "$RESET" >&2
  exit 1
fi

checks=(bash sudo pacman gum)
failed=0

printf 'Checking required commands:\n'
for command_name in "${checks[@]}"; do
  if command -v "$command_name" >/dev/null 2>&1; then
    printf '  [ok] %s -> %s\n' "$command_name" "$(command -v "$command_name")"
  else
    printf '  [missing] %s\n' "$command_name"
    failed=1
  fi
done

printf '\nChecking repository layout:\n'
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/.." && pwd)

for path in hyprland.lua kitty waybar fuzzel btop cava nvim quickshell; do
  if [[ -e "$repo_root/$path" ]]; then
    printf '  [found] %s\n' "$path"
  else
    printf '  [skip] %s (not present in this checkout)\n' "$path"
  fi
done

printf '\nNo packages will be installed.\n'
printf 'No configuration files will be copied.\n'

if (( failed )); then
  printf '\nDry run finished with missing dependencies.\n'
  exit 1
fi

printf '\nDry run passed. The main installer can be reviewed safely.\n'
