#!/usr/bin/env bash
set -Eeuo pipefail

readonly RED='\033[31m'
readonly RESET='\033[0m'

usage() {
  cat <<'USAGE'
Usage: volkanos-setup-dry-run

Checks installer dependencies and the configuration files available in
this Volkanos checkout. It never installs packages or copies configurations.
USAGE
}

if [[ ${1:-} == '--help' || ${1:-} == '-h' ]]; then
  usage
  exit 0
fi

if [[ $# -gt 0 ]]; then
  printf 'Unknown option: %s\n\n' "$1" >&2
  usage >&2
  exit 2
fi

printf '%bVOLKANOS SETUP — DRY RUN%b\n\n' "$RED" "$RESET"

if [[ ${EUID} -eq 0 ]]; then
  printf '%bDo not run this helper as root.%b\n' "$RED" "$RESET" >&2
  exit 1
fi

checks=(bash sudo pacman gum)
failed=0

printf 'Checking required commands:\n'
for command_name in "${checks[@]}"; do
  if command -v "$command_name" >/dev/null 2>&1; then
    printf '  [ok] %s -> %s\n' "$command_name" "$(command -v "$command_name")"
  else
    printf '  [missing] %s\n' "$command_name"
    failed=1
  fi
done

printf '\nChecking required repository files:\n'
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/.." && pwd)

required_files=(
  hyprland.lua
  hyprland.conf
  hyprlock.conf
)

for path in "${required_files[@]}"; do
  if [[ -f "$repo_root/$path" ]]; then
    printf '  [found] %s\n' "$path"
  else
    printf '  [missing] %s\n' "$path"
    failed=1
  fi
done

printf '\nChecking optional repository files:\n'
optional_files=(
  monitors.conf
  workspaces.conf
)

for path in "${optional_files[@]}"; do
  if [[ -f "$repo_root/$path" ]]; then
    printf '  [found] %s\n' "$path"
  else
    printf '  [skip] %s (not present in this checkout)\n' "$path"
  fi
done

printf '\nChecking component config directories:\n'
config_dirs=(
  kitty
  waybar
  fuzzel
  btop
  cava
  nvim
  quickshell
  niri
  fastfetch
  vibe
)

for path in "${config_dirs[@]}"; do
  if [[ -d "$repo_root/$path" ]]; then
    printf '  [found] %s/\n' "$path"
  else
    printf '  [missing] %s/\n' "$path"
    failed=1
  fi
done

printf '\nInstaller component coverage:\n'
for component in \
  Hyprland \
  Niri \
  Kitty \
  Waybar \
  Quickshell \
  Fuzzel \
  btop \
  Cava \
  Neovim \
  Fastfetch \
  Vibe \
  swww; do
  printf '  [ready] %s\n' "$component"
done

printf '\nNo packages will be installed.\n'
printf 'No configuration files will be copied.\n'

if (( failed )); then
  printf '\nDry run finished with repository or dependency errors.\n'
  exit 1
fi

printf '\nDry run finished. Review the report before running the main installer.\n'
